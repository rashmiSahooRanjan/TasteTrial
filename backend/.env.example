# Server Port (Render sets this automatically)
PORT=8000
NODE_ENV=production

# MongoDB Connection String (Atlas URI)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tastetrial?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer / Email Service
EMAIL=your_email@gmail.com
PASS=your_gmail_app_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend URLs for CORS (Replace with your actual Render deployment URLs)
FRONTEND_URL=https://your-frontend.onrender.com
ADMIN_FRONTEND_URL=https://your-admin-frontend.onrender.com

# Optional: Comma-separated additional allowed origins
# ALLOWED_ORIGINS=https://your-custom-domain.com,https://another-domain.com
