# Backend Server API URL (Render Web Service URL)
VITE_SERVER_URL=https://your-backend.onrender.com

# Geoapify Geocoding API Key
VITE_GEOAPIKEY=your_geoapify_api_key

# Razorpay Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxx

# Firebase API Key (for Google Auth)
VITE_FIREBASE_APIKEY=your_firebase_api_key

# Optional: Google Gemini API Key for AI Chatbot
VITE_GEMINI_API_KEY=your_gemini_api_key
